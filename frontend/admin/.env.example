# VITE_ADMIN_API_BASE: 调用 cmd/admin 接口时统一加的路径前缀。
# 默认 /admin-api：dev 下由 Vite proxy 转发到本地 cmd/admin（:8081）并去掉前缀，
# prod 下由 Nginx 做同样的反代（见 deploy-nginx.example.conf）。
# 注意：这里绝不能填 UFT_ADMIN_TOKEN，令牌由运营在登录页输入，只存 sessionStorage。
VITE_ADMIN_API_BASE=/admin-api

# VITE_ADMIN_ENV: 环境标识，production | staging | dev。
# production 时侧栏显示红色"生产环境"徽标，Header 顶部加红色边线，防止误操作。
VITE_ADMIN_ENV=dev

# ADMIN_API_TARGET（仅 dev server 使用，不会打进前端产物）：/admin-api 代理转发的目标，
# 默认 http://localhost:8081。本机 8081 被占用或联调远端环境时覆盖。
# ADMIN_API_TARGET=http://localhost:8081
