# VITE_GATEWAY_BASE_URL: gateway 的 base URL。
# 留空表示同源（推荐）：dev 下由 Vite proxy 转发 /v1 和 /console 到本地 gateway，
# prod 下由 Nginx 反代到 gateway，浏览器侧不需要跨域。
VITE_GATEWAY_BASE_URL=

# VITE_DOCS_PUBLIC_ORIGIN: 文档站对外的正式域名，只用于构建期产物（llms.txt、
# 页面 canonical）。页面里示例代码的 Base URL 始终按浏览器当前 origin 替换。
VITE_DOCS_PUBLIC_ORIGIN=https://ufreetokens.com
