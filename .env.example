# 复制为 .env 后按需修改，本地开发用
UFT_ENV=dev

UFT_GATEWAY_ADDR=:8080
UFT_ADMIN_ADDR=:8081
UFT_METRICS_ADDR=:9090

UFT_PG_DSN=postgres://uft:uft@localhost:5432/uft?sslmode=disable
UFT_PG_MAX_CONNS=20

UFT_REDIS_ADDR=localhost:6379
UFT_REDIS_PASSWORD=
UFT_REDIS_DB=0

# 上游 Key 信封加密的 KEK（生产环境应来自 KMS，本地开发可用任意 32 字节 base64；
# 例如用 `openssl rand -base64 32` 生成一个新的——不要在多台机器/多个环境之间复用）。
UFT_KEK=8PTzdjl8kOMJalrTbGLXTlQ4RiX1Tsi6zqm2MTrq/+U=
# API Key HMAC 的 pepper
UFT_KEY_PEPPER=dev-pepper-change-me
# cmd/admin 管理接口的鉴权密钥（httpx.RequireBearerToken）：调用方必须带
# `Authorization: Bearer <这个值>`，否则一律 401。cmd/admin 启动时这个变量
# 缺失/为空会直接拒绝启动，不会静默退化成不鉴权。
UFT_ADMIN_TOKEN=dev-admin-token-change-me

UFT_LOG_LEVEL=debug
UFT_LOG_FORMAT=console
