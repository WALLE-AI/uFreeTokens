# 选择被测的上游供应商：siliconflow（默认）/ openrouter / dashscope / volcengine，见 providers.py
UFT_PROVIDER=siliconflow

# 各供应商的上游 Key（L0 直连基线 + onboard.py 接入网关用），只需填要测的那家
SILICONFLOW_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
DASHSCOPE_API_KEY=sk-...
ARK_API_KEY=...

# 本地网关（L1），API Key 见 tmp/dev-stack/seed-output.txt 或用户端个人中心
UFT_GATEWAY_URL=http://localhost:8080/v1
UFT_API_KEY=sk-uft-...

# 运营后台（onboard.py 用）
UFT_ADMIN_URL=http://localhost:8081
UFT_ADMIN_TOKEN=dev-admin-token-change-me
